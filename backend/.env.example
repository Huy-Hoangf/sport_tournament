# Backend production/development environment
PORT=3001

# Neon/Supabase PostgreSQL
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USERNAME=your-postgres-user
DB_PASSWORD=your-postgres-password
DB_NAME=postgres
DB_SSL=true

# Comma-separated frontend origins allowed by CORS
FRONTEND_URL=http://localhost:3000,https://your-vercel-app.vercel.app

# Auth/session signing. Set a long random value in Render.
JWT_SECRET=replace-with-a-long-random-secret

# football-data.org is used as the football schedule source for supported major competitions.
FOOTBALL_DATA_ORG_API_KEY=your-football-data-org-key

# TheSportsDB is used as a fallback source for football team badges/logos. The public free key is 123.
THESPORTSDB_API_KEY=123

# Cito API for League of Legends schedule import. Keep the real key only in Render env.
CITO_API_KEY=your-cito-lol-api-key
